@page
@model LoginModel

@{
	ViewData["Title"] = "Aanmelden";
}

<section class="identity-page my-5">
	<div class="identity-card mx-auto">
		<div class="identity-card-header">
			<p class="identity-eyebrow">Welkom terug</p>
			<h1>Aanmelden</h1>
			<p>
				Meld je aan om je afspraken te bekijken, een nieuwe afspraak te boeken
				of je gegevens te beheren.
			</p>
		</div>

		<form id="account" method="post" class="identity-form">
			<div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

			<div class="form-floating mb-3">
				<input asp-for="Input.Email"
					   class="form-control"
					   autocomplete="username"
					   aria-required="true"
					   placeholder="naam@voorbeeld.be" />
				<label asp-for="Input.Email">E-mailadres</label>
				<span asp-validation-for="Input.Email" class="text-danger small"></span>
			</div>

			<div class="form-floating mb-3">
				<input asp-for="Input.Password"
					   class="form-control"
					   autocomplete="current-password"
					   aria-required="true"
					   placeholder="Wachtwoord" />
				<label asp-for="Input.Password">Wachtwoord</label>
				<span asp-validation-for="Input.Password" class="text-danger small"></span>
			</div>

			<div class="form-check mb-4">
				<input class="form-check-input" asp-for="Input.RememberMe" />
				<label class="form-check-label" asp-for="Input.RememberMe">
					Aangemeld blijven
				</label>
			</div>

			<button id="login-submit" type="submit" class="btn identity-primary-button w-100">
				Aanmelden
			</button>

			<div class="identity-links">
				<a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
					Nog geen account?
				</a>
			</div>
		</form>
	</div>
</section>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}