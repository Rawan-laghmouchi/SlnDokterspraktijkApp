<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dokterspraktijk.WebUI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dokterspraktijk.WebUI.styles.css" asp-append-version="true" />
</head>
<body>
	<header class="app-navbar">
		<div class="app-navbar-inner">
			<a class="app-navbar-brand"
			   asp-area=""
			   asp-controller="Home"
			   asp-action="Index">

				<img src="~/images/logo-hart.png"
					 alt="Logo Dokterspraktijk Laghmouchi"
					 class="app-navbar-logo" />

				<span>Dokterspraktijk Laghmouchi</span>
			</a>

			<nav class="app-navbar-links">
				<a class="app-navbar-link"
				   asp-area=""
				   asp-controller="Home"
				   asp-action="Index">
					Home
				</a>

				<a class="app-navbar-link"
				   asp-area=""
				   asp-controller="Afspraak"
				   asp-action="Create">
					Afspraak boeken
				</a>

				<a class="app-navbar-link"
				   asp-area=""
				   asp-controller="Afspraak"
				   asp-action="Index">
					Mijn afspraken
				</a>

				<a class="app-navbar-link"
				   asp-area=""
				   asp-controller="Home"
				   asp-action="OverOns">
					Over ons
				</a>
			</nav>
		</div>
	</header>
	<div class="page-content">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>
	<footer class="app-footer mt-5">
		<div class="container py-1">
			<div class="row gy-3 align-items-start">

				<div class="col-12 col-lg-4">
					<div class="d-flex align-items-center gap-2 mb-1">
						<img src="~/images/logo-hart.png"
							 alt="Logo Dokterspraktijk Laghmouchi"
							 class="footer-logo" />

						<h5 class="fw-bold fs-6 mb-0">
							Dokterspraktijk Laghmouchi
						</h5>
					</div>

					<p class="text-secondary small mb-0 footer-description">
						Zorg dichtbij, duidelijk en betrouwbaar.
					</p>
				</div>

				<div class="col-12 col-md-6 col-lg-4">
					<h6 class="fw-bold mb-2">Contact</h6>

					<p class="text-secondary small mb-1">
						<i class="bi bi-telephone me-2"></i>
						015 / 12 34 56
					</p>

					<p class="text-secondary small mb-1">
						<i class="bi bi-envelope me-2"></i>
						info@dokterspraktijklaghmouchi.be
					</p>

					<p class="text-secondary small mb-0">
						<i class="bi bi-geo-alt me-2"></i>
						Naamsestraat 120, 3000 Leuven
					</p>
				</div>

				<div class="col-12 col-md-6 col-lg-4">
					<h6 class="fw-bold mb-2">
						Openingsuren
					</h6>

					<div class="d-flex gap-3 text-secondary small mb-1">
						<span class="footer-day">Maandag – vrijdag</span>
						<strong class="text-dark">08:00 – 18:00</strong>
					</div>

					<div class="d-flex gap-3 text-secondary small mb-1">
						<span class="footer-day">Zaterdag – zondag</span>
						<strong class="text-dark">Gesloten</strong>
					</div>

					<p class="text-secondary small fst-italic mb-0">
						Voor dringende hulp buiten de openingsuren: bel 1733.
					</p>
				</div>

			</div>

			<hr class="my-3" />

			<p class="text-secondary small text-center mb-0">
				© 2026 Dokterspraktijk Laghmouchi. Alle rechten voorbehouden.
			</p>
		</div>
	</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
