@model AdminDokterFormViewModel

@{
    ViewData["Title"] = "Dokter bewerken";
}

<main class="container app-container py-4">

    <section class="home-soft-card p-4 mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <h1 class="h4 fw-bold text-dark mb-1">
                    Dokter bewerken
                </h1>

                <p class="text-secondary mb-0">
                    Pas de gegevens van de dokter aan.
                </p>
            </div>

            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-appointment-outline">
                Terug naar dashboard
            </a>
        </div>

        <form asp-controller="Admin"
              asp-action="EditDokter"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />

            <div class="mb-3">
                <label asp-for="Naam" class="form-label fw-semibold"></label>
                <input asp-for="Naam" class="form-control rounded-pill px-4" />
                <span asp-validation-for="Naam" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Specialisatie" class="form-label fw-semibold"></label>
                <input asp-for="Specialisatie" class="form-control rounded-pill px-4" />
                <span asp-validation-for="Specialisatie" class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-appointment-filled rounded-pill px-4">
                Wijzigingen opslaan
            </button>
        </form>
    </section>

</main>