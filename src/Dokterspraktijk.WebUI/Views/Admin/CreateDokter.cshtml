@model AdminDokterFormViewModel

@{
	ViewData["Title"] = "Dokter toevoegen";
}

<section class="container my-5">

	<div class="mb-4">
		<a asp-controller="Admin"
		   asp-action="Dokters"
		   class="text-decoration-none fw-semibold text-success">
			<i class="bi bi-arrow-left me-1"></i>
			Terug naar dokters beheren
		</a>

		<h1 class="fw-bold mt-3 mb-2">
			Nieuwe dokter toevoegen
		</h1>

		<p class="text-muted mb-0">
			Vul de gegevens van de nieuwe dokter in.
		</p>
	</div>

	<div class="card p-4">
		<form asp-controller="Admin"
			  asp-action="CreateDokter"
			  method="post">

			<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

			<div class="mb-3">
				<label asp-for="Naam" class="form-label fw-semibold"></label>
				<input asp-for="Naam"
					   class="form-control form-control-lg"
					   placeholder="Bijvoorbeeld: Timmermans" />
				<span asp-validation-for="Naam" class="text-danger"></span>
			</div>

			<div class="mb-4">
				<label asp-for="Specialisatie" class="form-label fw-semibold"></label>
				<input asp-for="Specialisatie"
					   class="form-control form-control-lg"
					   placeholder="Bijvoorbeeld: Huisarts" />
				<span asp-validation-for="Specialisatie" class="text-danger"></span>
			</div>

			<div class="d-flex gap-2 flex-wrap">
				<button type="submit" class="btn btn-primary rounded-pill px-4">
					Dokter toevoegen
				</button>

				<a asp-controller="Admin"
				   asp-action="Dokters"
				   class="btn btn-appointment-outline">
					Annuleren
				</a>
			</div>
		</form>
	</div>

</section>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}