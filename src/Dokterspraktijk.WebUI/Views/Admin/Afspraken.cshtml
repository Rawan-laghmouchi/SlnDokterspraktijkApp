@model AdminAfsprakenViewModel

@{
	ViewData["Title"] = "Afsprakenoverzicht";
}

<main class="container app-container py-4">

	<section class="home-soft-card p-4 mb-4">
		<div class="d-flex flex-column flex-xl-row justify-content-between align-items-start gap-3 mb-4">
			<div>
				<h1 class="h4 fw-bold text-dark mb-1">
					Afsprakenoverzicht
				</h1>

				<p class="text-secondary mb-0">
					Bekijk welke afspraken een dokter op een gekozen dag heeft.
				</p>
			</div>

			<form asp-controller="Admin"
				  asp-action="Afspraken"
				  method="get"
				  class="d-flex flex-column gap-2 admin-appointment-filter">

				<select name="dokterId"
						class="form-select appointment-filter-select"
						onchange="this.form.submit()">

					<option value="">Alle dokters</option>

					@foreach (DokterOverzichtViewModel dokter in Model.Dokters)
					{
						if (Model.GekozenDokterId == dokter.Id)
						{
							<option value="@dokter.Id" selected>
								Dokter: @dokter.Naam
							</option>
						}
						else
						{
							<option value="@dokter.Id">
								Dokter: @dokter.Naam
							</option>
						}
					}
				</select>

				<input type="date"
					   name="datum"
					   value="@Model.GekozenDatum.ToString("yyyy-MM-dd")"
					   class="form-control rounded-pill px-4 admin-date-input"
					   onchange="this.form.submit()" />
			</form>
		</div>

		@if (Model.Afspraken.Count == 0)
		{
			<div class="alert alert-info rounded-4 mb-0">
				Er zijn geen afspraken gevonden voor de gekozen dokter en datum.
			</div>
		}
		else
		{
			<div class="row g-4 align-items-start">
				<div class="col-12 col-lg-4">
					<div class="bg-light border rounded-4 p-4">
						<div class="d-flex align-items-center gap-3 mb-4">
							<span class="home-icon-circle">
								<i class="bi bi-calendar-day"></i>
							</span>

							<div>
								<div class="fw-bold">
									@Model.GekozenDatum.ToString("dd/MM/yyyy")
								</div>

								<div class="text-secondary">
									Gekozen dagplanning
								</div>
							</div>
						</div>

						<div class="mb-0">
							<div class="fw-bold admin-stat-number">
								@Model.Afspraken.Count afspraken
							</div>

							<div class="text-secondary">
								Raadpleeg de afspraken voor de gekozen dokter en datum.
							</div>
						</div>
					</div>
				</div>

				<div class="col-12 col-lg-8">
					<div class="table-responsive">
						<table class="table align-middle mb-0">
							<thead>
								<tr>
									<th>Tijd</th>
									<th>Patiënt</th>
									<th>Reden</th>
									<th>Status</th>
									<th>Actie</th>
								</tr>
							</thead>

							<tbody>
								@foreach (AfspraakDto afspraak in Model.Afspraken)
								{
									<tr>
										<td class="fw-bold admin-stat-number">
											@afspraak.Tijd.ToString("HH:mm")
										</td>

										<td>
											@afspraak.PatientVoornaam @afspraak.PatientAchternaam
										</td>

										<td>
											@afspraak.Reden
										</td>

										<td>
											@if (afspraak.Status == "Gepland")
											{
												<span class="status-pill status-active">
													Gepland
												</span>
											}
											else if (afspraak.Status == "Afgerond")
											{
												<span class="status-pill status-warning">
													Afgerond
												</span>
											}
											else
											{
												<span class="status-pill status-danger">
													@afspraak.Status
												</span>
											}
										</td>

										<td>
											<a asp-controller="Admin"
											   asp-action="AfspraakDetails"
											   asp-route-id="@afspraak.Id"
											   class="btn btn-sm btn-outline-primary rounded-pill px-3">
												Details
											</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		}
	</section>

</main>