@model AdminPatientenViewModel

@{
	ViewData["Title"] = "Patiëntenaccounts";
}

<section class="container my-5">

	<div class="mb-4">
		<h1 class="fw-bold mb-2">
			Patiëntenaccounts
		</h1>

		<p class="text-muted mb-0">
			Overzicht van patiënten met een gekoppeld account.
		</p>
	</div>

	<div class="card p-4 mb-5">
		<form asp-controller="Admin"
			  asp-action="Patienten"
			  method="get"
			  class="row g-3 mb-4">

			<div class="col-12 col-lg">
				<input asp-for="Zoekterm"
					   class="form-control form-control-lg"
					   placeholder="Zoek patiënt..." />
			</div>

			<div class="col-12 col-lg-auto">
				<button type="submit" class="btn btn-primary btn-lg rounded-pill px-4">
					Zoeken
				</button>
			</div>
		</form>

		@if (!Model.Patienten.Any())
		{
			<p class="text-muted mb-0">
				Er werden geen patiënten gevonden.
			</p>
		}
		else
		{
			<div class="table-responsive">
				<table class="table align-middle mb-0">
					<thead>
						<tr>
							<th>Patiënt</th>
							<th>E-mail</th>
							<th>Telefoon</th>
							<th>Rijksregisternummer</th>
							<th>Accountstatus</th>
							<th>Actie</th>
						</tr>
					</thead>

					<tbody>
						@foreach (PatientAccountViewModel patient in Model.Patienten)
						{
							<tr>
								<td class="fw-semibold">
									@patient.VolledigeNaam
								</td>

								<td>
									@patient.Email
								</td>

								<td>
									@patient.Telefoonnummer
								</td>

								<td>
									@patient.Rijksregisternummer
								</td>

								<td>
									@if (patient.IsAccountActief)
									{
										<span class="badge rounded-pill text-bg-success px-3 py-2">
											@patient.AccountStatus
										</span>
									}
									else
									{
										<span class="badge rounded-pill text-bg-secondary px-3 py-2">
											@patient.AccountStatus
										</span>
									}
								</td>

								<td>
									@if (patient.IsAccountActief)
									{
										<form asp-controller="Admin"
											  asp-action="DeactiveerPatientAccount"
											  asp-route-id="@patient.Id"
											  method="post">
											<button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
												Deactiveren
											</button>
										</form>
									}
									else
									{
										<form asp-controller="Admin"
											  asp-action="ActiveerPatientAccount"
											  asp-route-id="@patient.Id"
											  method="post">
											<button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3">
												Activeren
											</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>

</section>