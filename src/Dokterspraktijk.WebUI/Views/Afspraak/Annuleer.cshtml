@model AfspraakDto

@{
	ViewData["Title"] = "Afspraak annuleren";
}

<main class="container app-container py-3">

	<section class="app-header p-4 mb-4">
		<div>
			<h2 class="h3 fw-bold mb-1">Afspraak annuleren</h2>
			<p class="mb-0">
				Controleer de gegevens voor je de afspraak annuleert.
			</p>
		</div>
	</section>

	<div class="card app-soft-card">
		<div class="card-body p-4">

			<h5 class="fw-semibold mb-3">
				Ben je zeker dat je deze afspraak wil annuleren?
			</h5>

			<dl class="row mb-4">
				<dt class="col-sm-3">Patiënt</dt>
				<dd class="col-sm-9">@Model.PatientVoornaam @Model.PatientAchternaam</dd>

				<dt class="col-sm-3">Dokter</dt>
				<dd class="col-sm-9">@Model.DokterNaam</dd>

				<dt class="col-sm-3">Datum</dt>
				<dd class="col-sm-9">@Model.Datum.ToString("dd/MM/yyyy")</dd>

				<dt class="col-sm-3">Tijd</dt>
				<dd class="col-sm-9">@Model.Tijd.ToString("HH:mm")</dd>

				<dt class="col-sm-3">Reden</dt>
				<dd class="col-sm-9">@Model.Reden</dd>

				<dt class="col-sm-3">Status</dt>
				<dd class="col-sm-9">@Model.Status</dd>
			</dl>

			<div class="alert alert-warning rounded-4 border-0 mb-4" role="alert">
				Na het annuleren wordt het tijdslot opnieuw beschikbaar.
			</div>

			<form asp-controller="Afspraak"
				  asp-action="AnnuleerBevestigd"
				  method="post"
				  class="d-flex flex-column flex-sm-row gap-2">

				<input type="hidden" name="id" value="@Model.Id" />

				<button type="submit" class="btn btn-danger rounded-pill px-4">
					Afspraak annuleren
				</button>

				<a asp-controller="Afspraak"
				   asp-action="Index"
				   class="btn btn-appointment-outline">
					Terug naar overzicht
				</a>
			</form>

		</div>
	</div>

</main>