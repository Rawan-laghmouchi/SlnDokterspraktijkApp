@model AfspraakIndexViewModel

<main class="container app-container py-3">

	<section class="app-header p-4 mb-4">
		<div>
			<h2 class="h3 fw-bold mb-1">Mijn afspraken</h2>
			<p class="mb-0">
				Hier vind je jouw afspraken en vrijgegeven doktersattesten.
			</p>
		</div>
	</section>

	<div class="card app-soft-card">
		<div class="card-body p-4">

			<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
				<h5 class="fw-semibold mb-0">
					Afsprakenoverzicht
				</h5>

				<div class="d-flex flex-column flex-sm-row justify-content-end align-items-sm-center gap-2">
					<form asp-controller="Afspraak"
						  asp-action="Index"
						  method="get"
						  class="appointment-filter-form">

						<select asp-for="GekozenStatus"
								asp-items="Model.StatusOpties"
								class="form-select appointment-filter-select"
								onchange="this.form.submit()"
								aria-label="Filter op status">
							<option value="">Alle statussen</option>
						</select>
					</form>

					<a asp-controller="Afspraak"
					   asp-action="Create"
					   class="btn btn-appointment-outline">
						Nieuwe afspraak maken
					</a>
				</div>
			</div>

			@if (!Model.Afspraken.Any())
			{
				<div class="alert alert-info mb-0" role="alert">
					Er zijn geen afspraken gevonden.
				</div>
			}
			else
			{
				<div class="table-responsive">
					<table class="table align-middle mb-0">
						<thead>
							<tr>
								<th>Patiënt</th>
								<th>Dokter</th>
								<th>Datum</th>
								<th>Tijd</th>
								<th>Reden</th>
								<th>Status</th>
								<th>Doktersattest</th>
								<th>Actie</th>
							</tr>
						</thead>

						<tbody>
							@foreach (AfspraakDto afspraak in Model.Afspraken)
							{
								string statusCssClass = afspraak.Status.ToLower();

								DoktersattestDto? doktersattest = null;

								if (Model.DoktersattestenPerAfspraakId.ContainsKey(afspraak.Id))
								{
									doktersattest = Model.DoktersattestenPerAfspraakId[afspraak.Id];
								}

								<tr class="appointment-row-@statusCssClass">
									<td>@afspraak.PatientVoornaam @afspraak.PatientAchternaam</td>
									<td>@afspraak.DokterNaam</td>
									<td>@afspraak.Datum.ToString("dd/MM/yyyy")</td>
									<td>@afspraak.Tijd.ToString("HH:mm")</td>
									<td>@afspraak.Reden</td>

									<td>
										<span class="appointment-status-@statusCssClass">
											@afspraak.Status
										</span>
									</td>

									<td>
										@if (doktersattest != null && doktersattest.IsVrijgegeven && !doktersattest.IsGedownload)
										{
											<span class="badge rounded-pill text-bg-success px-3 py-2">
												Beschikbaar
											</span>
										}
										else if (doktersattest != null && doktersattest.IsGedownload)
										{
											<span class="badge rounded-pill text-bg-secondary px-3 py-2">
												Al gedownload
											</span>
										}
										else if (afspraak.Status == "Afgerond")
										{
											<span class="badge rounded-pill text-bg-warning px-3 py-2">
												Nog niet vrijgegeven
											</span>
										}
										else
										{
											<span class="text-muted">
												-
											</span>
										}
									</td>

									<td>
										@if (afspraak.Status == "Gepland")
										{
											<a asp-controller="Afspraak"
											   asp-action="Annuleer"
											   asp-route-id="@afspraak.Id"
											   class="btn btn-outline-danger rounded-pill px-3 py-1">
												Annuleren
											</a>
										}
										else if (doktersattest != null && doktersattest.IsVrijgegeven && !doktersattest.IsGedownload)
										{
											<form asp-controller="Afspraak"
												  asp-action="DownloadDoktersattest"
												  asp-route-id="@afspraak.Id"
												  method="post">
												<button type="submit" class="btn btn-primary rounded-pill px-3 py-1">
													Downloaden
												</button>
											</form>
										}
										else
										{
											<span class="text-muted">-</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}

		</div>
	</div>

</main>