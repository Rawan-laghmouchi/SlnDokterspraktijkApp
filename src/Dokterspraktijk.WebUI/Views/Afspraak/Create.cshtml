@model AfspraakCreateViewModel

@{
	ViewData["Title"] = "Maak een afspraak";
	string minimumDatum = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
	<div asp-validation-summary="All" class="text-danger mb-3"></div>
}

<main class="container app-container py-3">
	<div class="mb-3">
		<h2 class="fw-bold mb-1">Maak een afspraak</h2>
		<p class="text-muted mb-0">Kies uw arts, een datum en een beschikbaar tijdslot.</p>
	</div>

	<div id="dokterspraktijkBanner" class="carousel slide carousel-fade app-hero-carousel mb-4" data-bs-ride="carousel" data-bs-interval="3500">
		<div class="carousel-indicators">
			<button type="button" data-bs-target="#dokterspraktijkBanner" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
			<button type="button" data-bs-target="#dokterspraktijkBanner" data-bs-slide-to="1" aria-label="Slide 2"></button>
			<button type="button" data-bs-target="#dokterspraktijkBanner" data-bs-slide-to="2" aria-label="Slide 3"></button>
		</div>

		<div class="carousel-inner">
			<div class="carousel-item active">
				<img src="~/images/banner-dokter-1.png" class="d-block w-100" alt="Dokter met patiënt in consultatieruimte">
				<div class="carousel-caption app-hero-caption d-none d-md-block">
					<h1 class="display-6 mb-2">Plan snel je afspraak</h1>
					<p class="lead mb-0">Kies eenvoudig je dokter, datum en beschikbaar tijdstip.</p>
				</div>
			</div>

			<div class="carousel-item">
				<img src="~/images/banner-dokter-2.png" class="d-block w-100" alt="Medisch team in een moderne praktijk">
				<div class="carousel-caption app-hero-caption d-none d-md-block">
					<h1 class="display-6 mb-2">Jouw gegevens blijven duidelijk</h1>
					<p class="lead mb-0">Alle patiëntgegevens worden netjes verzameld voor je afspraak.</p>
				</div>
			</div>

			<div class="carousel-item">
				<img src="~/images/banner-dokter-3.png" class="d-block w-100" alt="Teamoverleg in de dokterspraktijk">
				<div class="carousel-caption app-hero-caption d-none d-md-block">
					<h1 class="display-6 mb-2">Van tijdslot tot bevestiging</h1>
					<p class="lead mb-0">Je ziet meteen een overzicht voor je de afspraak bevestigt.</p>
				</div>
			</div>
		</div>

		<button class="carousel-control-prev" type="button" data-bs-target="#dokterspraktijkBanner" data-bs-slide="prev">
			<span class="carousel-control-prev-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Vorige</span>
		</button>

		<button class="carousel-control-next" type="button" data-bs-target="#dokterspraktijkBanner" data-bs-slide="next">
			<span class="carousel-control-next-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Volgende</span>
		</button>
	</div>

	<section class="app-header p-4 mb-4">
		<div>
			<h2 class="h3 fw-bold mb-1">Afspraak maken</h2>
			<p class="mb-0 opacity-75">Kies een dokter, datum, tijdstip en vul je patiëntgegevens in.</p>
		</div>
	</section>

	<form asp-controller="Afspraak" asp-action="Create" method="get">
		<div class="card app-soft-card mb-4">
			<div class="card-body p-4">
				<h5 class="card-title fw-semibold mb-3">
					<span class="step-badge">1</span>
					Kies een dokter
				</h5>

				<div class="row g-3">
					@for (int i = 0; i < Model.Dokters.Count; i++)
					{
						string dokterId = $"dokter{i}";

						<div class="col-md-6">
							<input asp-for="DokterNaam"
								   type="radio"
								   class="btn-check"
								   id="@dokterId"
								   value="@Model.Dokters[i].Naam"
								   autocomplete="off"
								   data-testid="dokter-keuze" />

							<label class="card doctor-card h-100 p-3" for="@dokterId">
								<span class="fw-bold d-block">@Model.Dokters[i].Naam</span>
								<span class="text-muted">@Model.Dokters[i].Specialisatie</span>
							</label>
						</div>
					}
				</div>

				<span asp-validation-for="DokterNaam" class="text-danger small"></span>
			</div>
		</div>

		<div class="card app-soft-card mb-4">
			<div class="card-body p-4">
				<h5 class="card-title fw-semibold mb-3">
					<span class="step-badge">2</span>
					Kies een datum
				</h5>

				<input asp-for="Datum"
					   type="date"
					   class="form-control"
					   min="@minimumDatum"
					   data-testid="datum-veld" />

				<span asp-validation-for="Datum" class="text-danger small"></span>

				<p class="text-muted small mt-2 mb-2">
					De praktijk is gesloten tijdens het weekend.
				</p>

				<button type="submit"
						class="btn btn-link p-0 app-link-action"
						data-testid="beschikbaarheden-knop">
					Bekijk beschikbaarheden
				</button>
			</div>
		</div>
	</form>

	<form asp-controller="Afspraak" asp-action="Create" method="post">
		<input type="hidden" asp-for="DokterNaam" />
		<input type="hidden" asp-for="Datum" />
		<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

		<div class="card app-soft-card mb-4">
			<div class="card-body p-4">
				<h5 class="card-title fw-semibold mb-3">
					<span class="step-badge">3</span>
					Kies een tijdstip
				</h5>

				@if (Model.Tijdsloten.Count > 0)
				{
					<div class="d-flex flex-wrap gap-2">
						@for (int i = 0; i < Model.Tijdsloten.Count; i++)
						{
							string tijdslotId = $"tijdslot{i}";
							string tijdWaarde = Model.Tijdsloten[i].Tijd.ToString("HH:mm");

							<input asp-for="Tijd"
								   type="radio"
								   class="btn-check"
								   id="@tijdslotId"
								   value="@tijdWaarde"
								   data-testid="tijdslot-keuze" />

							<label class="btn btn-outline-primary rounded-pill px-4" for="@tijdslotId">
								@tijdWaarde
							</label>
						}
					</div>
				}

				<span asp-validation-for="Tijd" class="text-danger small" data-testid="tijdslot-foutmelding"></span>
			</div>
		</div>

		<div class="card app-soft-card mb-4">
			<div class="card-body p-4">
				<h5 class="card-title fw-semibold mb-3">
					<span class="step-badge">4</span>
					Patiëntgegevens
				</h5>

				<div class="row g-3">
					<div class="col-md-6">
						<label asp-for="PatientVoornaam" class="form-label">Voornaam</label>
						<input asp-for="PatientVoornaam" class="form-control" placeholder="Voornaam" data-testid="patient-voornaam-veld" />
						<span asp-validation-for="PatientVoornaam" class="text-danger small"></span>
					</div>

					<div class="col-md-6">
						<label asp-for="PatientAchternaam" class="form-label">Achternaam</label>
						<input asp-for="PatientAchternaam" class="form-control" placeholder="Achternaam" data-testid="patient-achternaam-veld" />
						<span asp-validation-for="PatientAchternaam" class="text-danger small"></span>
					</div>

					<div class="col-md-6">
						<label asp-for="Email" class="form-label">E-mail</label>
						<input asp-for="Email" class="form-control" placeholder="naam@gmail.be" data-testid="email-veld" />
						<span asp-validation-for="Email" class="text-danger small"></span>
					</div>

					<div class="col-md-6">
						<label asp-for="Telefoonnummer" class="form-label">Telefoonnummer</label>
						<input asp-for="Telefoonnummer" class="form-control" placeholder="+32 470 12 34 56" data-testid="telefoonnummer-veld" />
						<span asp-validation-for="Telefoonnummer" class="text-danger small"></span>
					</div>

					<div class="col-12">
						<label asp-for="Rijksregisternummer" class="form-label">Rijksregisternummer</label>
						<input asp-for="Rijksregisternummer" class="form-control" placeholder="XX.XX.XX-XXX.XX" data-testid="rijksregisternummer-veld" />
						<span asp-validation-for="Rijksregisternummer" class="text-danger small"></span>
					</div>
				</div>
			</div>
		</div>

		<div class="card app-soft-card mb-4">
			<div class="card-body p-4">
				<h5 class="card-title fw-semibold mb-3">
					<span class="step-badge">5</span>
					Kies de afspraakcategorie
				</h5>

				<select asp-for="Reden" class="form-select" data-testid="reden-select">
					<option value="">-- Kies een afspraakcategorie --</option>

					@foreach (AfspraakCategorieViewModel categorie in Model.AfspraakCategorieen)
					{
						<option value="@categorie.Naam">@categorie.Naam</option>
					}
				</select>

				<span asp-validation-for="Reden" class="text-danger small"></span>
			</div>
		</div>

		<div class="d-flex justify-content-center">
			<button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-semibold" data-testid="afspraak-bevestigen-knop">
				Afspraak bevestigen
			</button>
		</div>
	</form>
</main>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}