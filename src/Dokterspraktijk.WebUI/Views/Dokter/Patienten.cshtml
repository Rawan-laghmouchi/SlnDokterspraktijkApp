@model DokterPatientenViewModel

@{
	ViewData["Title"] = "Patiënten opzoeken";
}

<section class="container my-5">

	<div class="mb-4">
		<a asp-controller="Dokter"
		   asp-action="Index"
		   class="text-decoration-none fw-semibold text-success">
			<i class="bi bi-arrow-left me-1"></i>
			Terug naar dokterdashboard
		</a>

		<h1 class="fw-bold mt-3 mb-2">
			Patiënten opzoeken
		</h1>

		<p class="text-muted mb-0">
			Zoek patiënten op naam, e-mailadres of rijksregisternummer.
		</p>
	</div>

	<div class="card p-4 mb-4">
		<form asp-controller="Dokter"
			  asp-action="Patienten"
			  method="get"
			  class="row g-3">
			<div class="col-12 col-lg">
				<input asp-for="Zoekterm"
					   class="form-control form-control-lg"
					   placeholder="Zoek patiënt..." />
			</div>

			<div class="col-12 col-lg-auto">
				<button type="submit" class="btn btn-primary btn-lg rounded-pill px-4">
					Zoeken
				</button>
			</div>
		</form>
	</div>

	<div class="card p-4">
		@if (!Model.Patienten.Any())
		{
			<p class="text-muted mb-0">
				Er werden geen patiënten gevonden.
			</p>
		}
		else
		{
			<div class="table-responsive">
				<table class="table align-middle mb-0">
					<thead>
						<tr>
							<th>Naam</th>
							<th>E-mail</th>
							<th>Telefoonnummer</th>
							<th>Rijksregisternummer</th>
						</tr>
					</thead>
					<tbody>
						@foreach (PatientOverzichtViewModel patient in Model.Patienten)
						{
							<tr>
								<td>@patient.VolledigeNaam</td>
								<td>@patient.Email</td>
								<td>@patient.Telefoonnummer</td>
								<td>@patient.Rijksregisternummer</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>

</section>