@model DokterAfsprakenViewModel

@{
	ViewData["Title"] = "Afspraken beheren";
}

<section class="container my-5">

	<div class="mb-4">
		<h1 class="fw-bold mb-2">
			Afspraken beheren
		</h1>

		<p class="text-muted mb-0">
			Overzicht van afspraken die de dokter kan opvolgen.
		</p>
	</div>

	<div class="card p-4 mb-5">
		<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
			<div>
				<h2 class="h4 fw-bold mb-1">
					Alle afspraken
				</h2>

				<p class="text-muted mb-0">
					Filter op status of bekijk de details van een afspraak.
				</p>
			</div>

			<form asp-controller="Dokter"
				  asp-action="Afspraken"
				  method="get"
				  class="appointment-filter-form">
				<select name="status"
						class="form-select appointment-filter-select"
						onchange="this.form.submit()"
						aria-label="Filter op status">
					@if (string.IsNullOrWhiteSpace(Model.GekozenStatus))
					{
						<option value="" selected>Filter: alle statussen</option>
					}
					else
					{
						<option value="">Filter: alle statussen</option>
					}

					@if (Model.GekozenStatus == "Gepland")
					{
						<option value="Gepland" selected>Gepland</option>
					}
					else
					{
						<option value="Gepland">Gepland</option>
					}

					@if (Model.GekozenStatus == "Geannuleerd")
					{
						<option value="Geannuleerd" selected>Geannuleerd</option>
					}
					else
					{
						<option value="Geannuleerd">Geannuleerd</option>
					}

					@if (Model.GekozenStatus == "Afgerond")
					{
						<option value="Afgerond" selected>Afgerond</option>
					}
					else
					{
						<option value="Afgerond">Afgerond</option>
					}
				</select>
			</form>
		</div>

		@if (!Model.Afspraken.Any())
		{
			<p class="text-muted mb-0">
				Er werden geen afspraken gevonden.
			</p>
		}
		else
		{
			<div class="table-responsive">
				<table class="table align-middle mb-0">
					<thead>
						<tr>
							<th>Patiënt</th>
							<th>Dokter</th>
							<th>Datum</th>
							<th>Tijd</th>
							<th>Reden</th>
							<th>Status</th>
							<th>Actie</th>
						</tr>
					</thead>

					<tbody>
						@foreach (AfspraakDto afspraak in Model.Afspraken)
						{
							<tr>
								<td>@afspraak.PatientVoornaam @afspraak.PatientAchternaam</td>
								<td>@afspraak.DokterNaam</td>
								<td>@afspraak.Datum.ToString("dd/MM/yyyy")</td>
								<td>@afspraak.Tijd.ToString("HH:mm")</td>
								<td>@afspraak.Reden</td>

								<td>
									@if (afspraak.Status == "Gepland")
									{
										<span class="badge rounded-pill text-bg-success px-3 py-2">
											@afspraak.Status
										</span>
									}
									else if (afspraak.Status == "Geannuleerd")
									{
										<span class="badge rounded-pill text-bg-danger px-3 py-2">
											@afspraak.Status
										</span>
									}
									else
									{
										<span class="badge rounded-pill text-bg-secondary px-3 py-2">
											@afspraak.Status
										</span>
									}
								</td>

								<td>
									@if (afspraak.Status == "Gepland")
									{
										<div class="d-flex gap-2 flex-wrap">
											<form asp-controller="Dokter"
												  asp-action="Afronden"
												  asp-route-id="@afspraak.Id"
												  method="post">
												<button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">
													Afronden
												</button>
											</form>

											<form asp-controller="Dokter"
												  asp-action="Annuleren"
												  asp-route-id="@afspraak.Id"
												  method="post">
												<button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
													Annuleren
												</button>
											</form>

											<a asp-controller="Dokter"
											   asp-action="Details"
											   asp-route-id="@afspraak.Id"
											   class="btn btn-sm btn-outline-primary rounded-pill px-3">
												Details
											</a>
										</div>
									}
									else
									{
										<a asp-controller="Dokter"
										   asp-action="Details"
										   asp-route-id="@afspraak.Id"
										   class="btn btn-sm btn-outline-primary rounded-pill px-3">
											Details
										</a>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>

</section>