@using Dokterspraktijk.Application.Dto_s
@model DokterAfspraakDetailsViewModel

@{
	ViewData["Title"] = "Afspraakdetails";

	AfspraakDto afspraak = Model.Afspraak;
	DoktersattestDto? doktersattest = Model.Doktersattest;
}

<section class="container my-5">

	<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
		<div>
			<a asp-controller="Dokter"
			   asp-action="Afspraken"
			   class="text-decoration-none fw-semibold text-success">
				<i class="bi bi-arrow-left me-1"></i>
				Terug naar afspraken beheren
			</a>

			<h1 class="fw-bold mt-3 mb-2">
				Afspraakdetails
			</h1>

			<p class="text-muted mb-0">
				Bekijk de afspraakgegevens en voer acties uit waar nodig.
			</p>
		</div>

		@if (afspraak.Status == "Gepland")
		{
			<div class="d-flex gap-2 flex-wrap">
				<form asp-controller="Dokter"
					  asp-action="Afronden"
					  asp-route-id="@afspraak.Id"
					  method="post">
					<button type="submit" class="btn btn-primary rounded-pill px-4">
						<i class="bi bi-check2-circle me-1"></i>
						Afronden
					</button>
				</form>

				<form asp-controller="Dokter"
					  asp-action="Annuleren"
					  asp-route-id="@afspraak.Id"
					  method="post">
					<button type="submit" class="btn btn-outline-danger rounded-pill px-4">
						<i class="bi bi-x-circle me-1"></i>
						Annuleren
					</button>
				</form>
			</div>
		}
	</div>

	<div class="row g-4">
		<div class="col-12 col-xl-8">

			<div class="card p-4 mb-4">
				<div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
					<div class="d-flex align-items-center gap-3">
						<span class="home-icon-circle">
							<i class="bi bi-calendar-check"></i>
						</span>

						<div>
							<h2 class="h4 fw-bold mb-1">
								Consultatie
							</h2>

							<p class="text-muted mb-0">
								Afspraak bij Dr. @afspraak.DokterNaam
							</p>
						</div>
					</div>

					<div>
						@if (afspraak.Status == "Gepland")
						{
							<span class="badge rounded-pill text-bg-success px-3 py-2">
								@afspraak.Status
							</span>
						}
						else if (afspraak.Status == "Geannuleerd")
						{
							<span class="badge rounded-pill text-bg-danger px-3 py-2">
								@afspraak.Status
							</span>
						}
						else
						{
							<span class="badge rounded-pill text-bg-secondary px-3 py-2">
								@afspraak.Status
							</span>
						}
					</div>
				</div>

				<div class="row g-3">
					<div class="col-md-3">
						<div class="bg-light border rounded-4 p-3 h-100">
							<div class="small text-muted fw-bold">Datum</div>
							<div class="fw-semibold">@afspraak.Datum.ToString("dd/MM/yyyy")</div>
						</div>
					</div>

					<div class="col-md-3">
						<div class="bg-light border rounded-4 p-3 h-100">
							<div class="small text-muted fw-bold">Tijd</div>
							<div class="fw-semibold">@afspraak.Tijd.ToString("HH:mm")</div>
						</div>
					</div>

					<div class="col-md-3">
						<div class="bg-light border rounded-4 p-3 h-100">
							<div class="small text-muted fw-bold">Status</div>
							<div class="fw-semibold">@afspraak.Status</div>
						</div>
					</div>

					<div class="col-md-3">
						<div class="bg-light border rounded-4 p-3 h-100">
							<div class="small text-muted fw-bold">Dokter</div>
							<div class="fw-semibold">@afspraak.DokterNaam</div>
						</div>
					</div>
				</div>
			</div>

			<div class="card p-4 mb-4">
				<h2 class="h4 fw-bold mb-3">
					Reden van afspraak
				</h2>

				<div class="bg-light border rounded-4 p-3">
					<p class="mb-0">
						@afspraak.Reden
					</p>
				</div>
			</div>

			<div class="card p-4">
				<h2 class="h4 fw-bold mb-3">
					Actiegeschiedenis
				</h2>

				<div class="border-start border-3 ps-3">
					<div class="mb-3">
						<div class="fw-bold">Afspraak aangemaakt</div>
						<div class="text-muted">
							De patiënt heeft deze afspraak aangevraagd.
						</div>
					</div>

					<div>
						<div class="fw-bold">Huidige status</div>
						<div class="text-muted">
							Deze afspraak staat momenteel op: @afspraak.Status.
						</div>
					</div>
				</div>
			</div>

		</div>

		<div class="col-12 col-xl-4">

			<div class="card p-4 mb-4">
				<div class="d-flex align-items-center gap-3 mb-4">
					<div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center fw-bold"
						 style="width: 56px; height: 56px;">
						@afspraak.PatientVoornaam.Substring(0, 1)@afspraak.PatientAchternaam.Substring(0, 1)
					</div>

					<div>
						<h2 class="h5 fw-bold mb-1">
							@afspraak.PatientVoornaam @afspraak.PatientAchternaam
						</h2>

						<p class="text-muted mb-0">
							Patiënt
						</p>
					</div>
				</div>

				<div class="mb-3">
					<div class="small text-muted fw-bold">E-mail</div>
					<div class="fw-semibold">@afspraak.PatientEmail</div>
				</div>

				<div class="mb-3">
					<div class="small text-muted fw-bold">Telefoon</div>
					<div class="fw-semibold">@afspraak.PatientTelefoonnummer</div>
				</div>

				<div class="mb-3">
					<div class="small text-muted fw-bold">Rijksregisternummer</div>
					<div class="fw-semibold">@afspraak.PatientRijksregisternummer</div>
				</div>

				<a asp-controller="Dokter"
				   asp-action="Patienten"
				   asp-route-zoekterm="@afspraak.PatientAchternaam"
				   class="btn btn-appointment-outline w-100 mt-2">
					Patiënt opzoeken
				</a>
			</div>

			<div class="card p-4 mb-4">
				<h2 class="h5 fw-bold mb-3">
					Doktersattest
				</h2>

				@if (afspraak.Status != "Afgerond")
				{
					<p class="text-muted mb-0">
						Een doktersattest kan pas worden vrijgegeven nadat de consultatie is afgerond.
					</p>
				}
				else if (doktersattest != null && doktersattest.IsVrijgegeven)
				{
					<span class="badge rounded-pill text-bg-success px-3 py-2 mb-3">
						Vrijgegeven
					</span>

					@if (doktersattest.IsGedownload)
					{
						<p class="text-muted mb-0">
							De patiënt heeft dit attest al gedownload.
						</p>
					}
					else
					{
						<p class="text-muted mb-0">
							De patiënt kan dit attest nu downloaden.
						</p>
					}
				}
				else
				{
					<p class="text-muted">
						De consultatie is afgerond. Je kan het doktersattest nu vrijgeven voor de patiënt.
					</p>

					<form asp-controller="Dokter"
						  asp-action="GeefDoktersattestVrij"
						  asp-route-id="@afspraak.Id"
						  method="post">
						<button type="submit" class="btn btn-primary rounded-pill px-4">
							<i class="bi bi-file-earmark-medical me-1"></i>
							Doktersattest vrijgeven
						</button>
					</form>
				}
			</div>

			<div class="card p-4">
				<h2 class="h5 fw-bold mb-3">
					Dokteracties
				</h2>

				<p class="text-muted">
					Vanuit deze pagina kan de dokter de afspraak opvolgen en de patiëntgegevens raadplegen.
				</p>

				<a asp-controller="Afspraak"
				   asp-action="Create"
				   asp-route-patientVoornaam="@afspraak.PatientVoornaam"
				   asp-route-patientAchternaam="@afspraak.PatientAchternaam"
				   class="btn btn-appointment-outline w-100">
					Vervolgafspraak plannen
				</a>
			</div>

		</div>
	</div>

</section>